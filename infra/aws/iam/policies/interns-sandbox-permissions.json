{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SandboxConsoleDiscovery",
      "Effect": "Allow",
      "Action": [
        "lambda:ListFunctions",
        "events:ListEventBuses",
        "events:ListRules",
        "dynamodb:ListTables",
        "s3:ListAllMyBuckets",
        "s3:GetBucketLocation"
      ],
      "Resource": "*"
    },
    {
      "Sid": "CreateTaggedLambda",
      "Effect": "Allow",
      "Action": [
        "lambda:CreateFunction",
        "lambda:TagResource"
      ],
      "Resource": "arn:aws:lambda:ap-south-1:483591406604:function:learninglab-*",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/Environment": "LearningLab",
          "aws:RequestTag/SessionId": "${aws:PrincipalTag/SessionId}",
          "aws:RequestTag/ExpirationTime": "${aws:PrincipalTag/ExpirationTime}"
        },
        "ForAllValues:StringEquals": {
          "aws:TagKeys": [
            "Environment",
            "SessionId",
            "ExpirationTime"
          ]
        },
        "Null": {
          "aws:RequestTag/ExpirationTime": "false"
        }
      }
    },
    {
      "Sid": "ManageSessionLambda",
      "Effect": "Allow",
      "Action": [
        "lambda:InvokeFunction",
        "lambda:UpdateFunctionCode",
        "lambda:UpdateFunctionConfiguration",
        "lambda:DeleteFunction",
        "lambda:GetFunction",
        "lambda:GetFunctionConfiguration",
        "lambda:GetPolicy",
        "lambda:AddPermission",
        "lambda:RemovePermission",
        "lambda:ListTags"
      ],
      "Resource": "arn:aws:lambda:ap-south-1:483591406604:function:learninglab-*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Environment": "LearningLab",
          "aws:ResourceTag/SessionId": "${aws:PrincipalTag/SessionId}",
          "aws:ResourceTag/ExpirationTime": "${aws:PrincipalTag/ExpirationTime}"
        }
      }
    },
    {
      "Sid": "CreateTaggedEventBridgeResources",
      "Effect": "Allow",
      "Action": [
        "events:CreateEventBus",
        "events:PutRule",
        "events:TagResource"
      ],
      "Resource": [
        "arn:aws:events:ap-south-1:483591406604:event-bus/learninglab-*",
        "arn:aws:events:ap-south-1:483591406604:rule/learninglab-*",
        "arn:aws:events:ap-south-1:483591406604:rule/*/learninglab-*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/Environment": "LearningLab",
          "aws:RequestTag/SessionId": "${aws:PrincipalTag/SessionId}",
          "aws:RequestTag/ExpirationTime": "${aws:PrincipalTag/ExpirationTime}"
        },
        "ForAllValues:StringEquals": {
          "aws:TagKeys": [
            "Environment",
            "SessionId",
            "ExpirationTime"
          ]
        },
        "Null": {
          "aws:RequestTag/ExpirationTime": "false"
        }
      }
    },
    {
      "Sid": "ManageSessionEventBridgeResources",
      "Effect": "Allow",
      "Action": [
        "events:PutRule",
        "events:PutTargets",
        "events:RemoveTargets",
        "events:DeleteRule",
        "events:DeleteEventBus",
        "events:DescribeRule",
        "events:ListTargetsByRule",
        "events:EnableRule",
        "events:DisableRule",
        "events:ListTagsForResource"
      ],
      "Resource": [
        "arn:aws:events:ap-south-1:483591406604:event-bus/learninglab-*",
        "arn:aws:events:ap-south-1:483591406604:rule/learninglab-*",
        "arn:aws:events:ap-south-1:483591406604:rule/*/learninglab-*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Environment": "LearningLab",
          "aws:ResourceTag/SessionId": "${aws:PrincipalTag/SessionId}",
          "aws:ResourceTag/ExpirationTime": "${aws:PrincipalTag/ExpirationTime}"
        }
      }
    },
    {
      "Sid": "CreateTaggedDynamoDbTable",
      "Effect": "Allow",
      "Action": [
        "dynamodb:CreateTable",
        "dynamodb:TagResource"
      ],
      "Resource": "arn:aws:dynamodb:ap-south-1:483591406604:table/learninglab-*",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/Environment": "LearningLab",
          "aws:RequestTag/SessionId": "${aws:PrincipalTag/SessionId}",
          "aws:RequestTag/ExpirationTime": "${aws:PrincipalTag/ExpirationTime}"
        },
        "ForAllValues:StringEquals": {
          "aws:TagKeys": [
            "Environment",
            "SessionId",
            "ExpirationTime"
          ]
        },
        "Null": {
          "aws:RequestTag/ExpirationTime": "false"
        }
      }
    },
    {
      "Sid": "ManageSessionDynamoDbTable",
      "Effect": "Allow",
      "Action": [
        "dynamodb:UpdateTable",
        "dynamodb:DeleteTable",
        "dynamodb:DescribeTable",
        "dynamodb:DescribeContinuousBackups",
        "dynamodb:DescribeTimeToLive",
        "dynamodb:PutItem",
        "dynamodb:GetItem",
        "dynamodb:UpdateItem",
        "dynamodb:DeleteItem",
        "dynamodb:Query",
        "dynamodb:Scan",
        "dynamodb:BatchWriteItem",
        "dynamodb:BatchGetItem",
        "dynamodb:ListTagsOfResource",
        "dynamodb:ListStreams",
        "dynamodb:DescribeStream",
        "dynamodb:GetRecords",
        "dynamodb:GetShardIterator"
      ],
      "Resource": [
        "arn:aws:dynamodb:ap-south-1:483591406604:table/learninglab-*",
        "arn:aws:dynamodb:ap-south-1:483591406604:table/learninglab-*/index/*",
        "arn:aws:dynamodb:ap-south-1:483591406604:table/learninglab-*/stream/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Environment": "LearningLab",
          "aws:ResourceTag/SessionId": "${aws:PrincipalTag/SessionId}",
          "aws:ResourceTag/ExpirationTime": "${aws:PrincipalTag/ExpirationTime}"
        }
      }
    },
    {
      "Sid": "CreateLearningLabS3Bucket",
      "Effect": "Allow",
      "Action": "s3:CreateBucket",
      "Resource": "arn:aws:s3:::learninglab-session-*"
    },
    {
      "Sid": "ManageSessionS3Bucket",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketLocation",
        "s3:GetBucketTagging",
        "s3:PutBucketTagging",
        "s3:GetBucketVersioning",
        "s3:PutBucketVersioning",
        "s3:GetEncryptionConfiguration",
        "s3:PutEncryptionConfiguration",
        "s3:GetBucketNotification",
        "s3:PutBucketNotification",
        "s3:ListBucket",
        "s3:ListBucketVersions",
        "s3:ListBucketMultipartUploads",
        "s3:DeleteBucket"
      ],
      "Resource": "arn:aws:s3:::learninglab-${aws:PrincipalTag/SessionId}-*"
    },
    {
      "Sid": "ManageSessionS3Objects",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:GetObjectVersion",
        "s3:DeleteObject",
        "s3:DeleteObjectVersion",
        "s3:AbortMultipartUpload",
        "s3:ListMultipartUploadParts"
      ],
      "Resource": "arn:aws:s3:::learninglab-${aws:PrincipalTag/SessionId}-*/*"
    },
    {
      "Sid": "ReadLambdaExecutionRole",
      "Effect": "Allow",
      "Action": "iam:GetRole",
      "Resource": "arn:aws:iam::483591406604:role/interns-lambda-execution-role"
    },
    {
      "Sid": "PassLambdaExecutionRole",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::483591406604:role/interns-lambda-execution-role",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "lambda.amazonaws.com"
        }
      }
    }
  ]
}
