{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowBackendUserAssumeRole",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::ACCOUNT_ID:user/learning-platform-backend"
      },
      "Action": [
        "sts:AssumeRole",
        "sts:TagSession"
      ]
    }
  ]
}
