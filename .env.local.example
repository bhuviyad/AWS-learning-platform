# Local override for lab start/stop functions (for local dev or mocks)
# If these are set, the frontend will call these URLs directly instead of Supabase functions.
# Use full absolute URLs (including https://) or local endpoints like http://localhost:8787/start-lab
VITE_LOCAL_START_LAB_URL=
VITE_LOCAL_STOP_LAB_URL=

# Keep your Supabase keys for when you want to use the real backend
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=sb_publishable_...

# Admin dashboard access
# Set the same email in both frontend and backend deployment environments.
# VITE_ADMIN_EMAIL=admin@your-domain.com
# ADMIN_EMAIL=admin@your-domain.com

# Backend Supabase service role used by the Render/local mock server
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=service_role_...

# The backend also needs AWS env vars for lab start/stop and cleanup.
# These are usually set in Render or Supabase secrets instead of the frontend env file.
# AWS_REGION=ap-south-1
# AWS_LAB_ROLE_ARN=arn:aws:iam::123456789012:role/LabInternRole
# AWS_LAMBDA_EXECUTION_ROLE_ARN=arn:aws:iam::123456789012:role/LearningLabLambdaExecutionRole
# AWS_SESSION_REVOKER_FUNCTION_NAME=learninglab-session-revoker

# Server-side AWS credentials used by the Supabase edge function and local mock.
# Prefer setting these as Supabase secrets instead of committing them to the repo.
# You can use either the generic names or the explicit lab-user names.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# AWS_LAB_USER_ACCESS_KEY_ID=
# AWS_LAB_USER_SECRET_ACCESS_KEY=
# AWS_LAB_USER_SESSION_TOKEN=
# AWS_REGION=ap-south-1
# AWS_LAB_ROLE_ARN=arn:aws:iam::123456789012:role/LabInternRole
# AWS_LAMBDA_EXECUTION_ROLE_ARN=arn:aws:iam::123456789012:role/LearningLabLambdaExecutionRole
# AWS_SESSION_REVOKER_FUNCTION_NAME=learninglab-session-revoker

# By default we use AWS Console federation which signs users straight into
# the AWS Console. Set this to override the destination (console URL).
# Recommended (preferred):
VITE_AWS_CONSOLE_DESTINATION=https://console.aws.amazon.com/console/home?region=ap-south-1

# Cleanup scheduler endpoint used by Render cron jobs or local scripts.
# For production, point this at the deployed cleanup-expired-labs endpoint.
# Example:
# LAB_CLEANUP_URL=https://your-supabase-project.supabase.co/functions/v1/cleanup-expired-labs
LAB_CLEANUP_URL=
LAB_CLEANUP_METHOD=POST

# Set this to "true" to force the app to use local auth and local lab endpoints
# (bypass Supabase entirely). Useful for offline local development.
VITE_FORCE_LOCAL=true
